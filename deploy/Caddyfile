# Automatic HTTPS for the shop and the backend/admin.
{$SITE_DOMAIN} {
	encode zstd gzip
	reverse_proxy storefront:3000
}

www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}

{$ADMIN_DOMAIN} {
	encode zstd gzip
	# the admin panel lives at /app — send the bare address there
	@root path /
	redir @root /app 302
	request_body {
		max_size 60MB
	}
	reverse_proxy backend:9000
}
