# Automatic HTTPS for the shop and the backend/admin.
# Other sites on this server: drop a <name>.caddy file in /opt/caddy-sites on the host (see DEPLOY.md → "Other sites").
import /etc/caddy/sites/*.caddy

{$SITE_DOMAIN} {
	encode zstd gzip
	reverse_proxy storefront:3000
}

www.{$SITE_DOMAIN} {
	redir https://{$SITE_DOMAIN}{uri} permanent
}

{$ADMIN_DOMAIN} {
	encode zstd gzip
	# the admin panel lives at /app — send the bare address there
	@root path /
	redir @root /app 302
	request_body {
		max_size 60MB
	}
	reverse_proxy backend:9000
}
