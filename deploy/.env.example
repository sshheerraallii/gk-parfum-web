# Domains (point both DNS A records at the server first)
SITE_DOMAIN=gkparfum.co.uk
ADMIN_DOMAIN=admin.gkparfum.co.uk

# Generate each with:  openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_SECRET=
COOKIE_SECRET=
AUTH_MFA_ENCRYPTION_KEY=

# First admin login, created on first boot (you can delete these two lines afterwards)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Filled in after first boot: Admin → Settings → Publishable API keys
MEDUSA_PUBLISHABLE_KEY=

# Stripe (Dashboard → Developers → API keys). Leave empty to run checkout in test mode.
STRIPE_API_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
